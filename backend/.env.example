# Data Mode Flag (default: true for instant offline demo with zero API keys)
# Set to false to enable live OpenTopography & Open-Meteo API requests
USE_MOCK_DATA=true

# OpenTopography API Key (only required when USE_MOCK_DATA=false)
# Sign up for a free key at: https://portal.opentopography.org/myopentopo
OPENTOPOGRAPHY_API_KEY=""

# ==============================================================================
# MSG91 SMS & FLOW CONFIGURATION (For SOS Emergency Alert Dispatches)
# ==============================================================================
# Set to "false" to send live real SMS via MSG91, or "true" for simulated mock dispatch
MOCK_SMS=false

# Your MSG91 Auth Key (from MSG91 Dashboard -> Authkey)
MSG91_AUTH_KEY=""

# Your MSG91 Flow ID (Template ID created in MSG91 -> SMS -> Flow)
MSG91_TEMPLATE_ID=""

# Your approved 6-character MSG91 Sender ID (e.g. SLPRSC)
MSG91_SENDER_ID="SLPRSC"

# Server settings
HOST="127.0.0.1"
PORT=8001
